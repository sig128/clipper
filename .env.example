# Clipforge environment. Copy to .env and fill in. No secrets are committed.
# Everything in Milestone 1 runs with NO paid keys — the entries below are for
# later milestones and are optional until then.

# --- core infra (docker-compose provides these locally) ---
DATABASE_URL=postgres://clipforge:clipforge@localhost:5432/clipforge
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RENDER_CONCURRENCY=2

# --- owner auth (private deployment) ---
OWNER_EMAIL=
SESSION_SECRET=

# --- M2: AI moments (optional) ---
GEMINI_API_KEY=            # agentic video understanding
DEEPGRAM_API_KEY=          # optional managed STT (faster-whisper is the local default)

# --- M3: covers + enhancement (optional) ---
BFL_API_KEY=               # FLUX image generation
TOPAZ_API_KEY=             # managed enhancement (Real-ESRGAN is the local default)

# --- M4: sources (optional) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- M5: publishing (optional) ---
# YouTube: one Google Cloud OAuth client, one refresh token per posting account
# (the account id from the Plan, upper-cased, e.g. A1 -> YT_REFRESH_TOKEN_A1).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN_A1=
YT_DAILY_UNITS=10000       # raise only after a quota extension
# Instagram (Instagram Login, professional account): user id + long-lived token per account.
IG_USER_ID_A1=
IG_TOKEN_A1=
IG_GRAPH_BASE=https://graph.instagram.com
IG_GRAPH_VERSION=v23.0
PUBLISH_STATE_DIR=/var/lib/clipforge   # intents.json lives here (never double-post)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
AYRSHARE_API_KEY=
# TikTok is export/handoff only for an owner app — no publish credentials needed.

# --- M6: research + bridge (optional) ---
XAI_API_KEY=
BRIDGE_HMAC_SECRET=

# --- object storage (remote deploy) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
